[Terrain]
	PrefabRoot = art\prefabs\campaign
	save_final_tile_map = true
	generate_global_mesh = true
	TileDatabase = terrain\tiles\campaign\_tile_database
	save_meta_data_map = false
	export_devastation_pieces = true
	cam_hmap_resolution_scale = 0.25
	cam_hmap_samples_per_wu = 8
	cam_hmap_apply_blur = false

[Texture]
	<Files> = ..._normal.*
	CompressionFormat = dxt5n
	NormalMap = true
